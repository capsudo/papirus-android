{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Update Papirus icons",
      "type": "process",
      "command": "direnv",
      "args": [
        "exec",
        ".",
        "${workspaceFolder}/scripts/update_icons.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build debug APK",
      "type": "process",
      "command": "direnv",
      "args": [
        "exec",
        ".",
        "bash",
        "-c",
        "make build && ./gradlew assembleDebug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}

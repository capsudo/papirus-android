{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Update Papirus icons",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/update_icons.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build icon resources",
      "type": "shell",
      "command": "make build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Assemble debug APK",
      "type": "shell",
      "command": "./gradlew assembleDebug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Assemble release APK",
      "type": "shell",
      "command": "./gradlew assembleRelease",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Create GitHub release",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/create_github_release.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}

{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Update Papirus icons",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/update_icons.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build icon resources",
      "type": "shell",
      "command": "make build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Assemble debug APK",
      "type": "shell",
      "command": "./gradlew assembleDebug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Assemble release APK",
      "type": "shell",
      "command": "./gradlew assembleRelease",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Create GitHub release",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/create_github_release.sh",
      "args": [
        "--release-title",
        "${input:releaseTitle}",
        "--release-message",
        "${input:releaseMessage}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "releaseTitle",
      "type": "promptString",
      "description": "Release title and Android versionName (example: 20260801.4)",
      "default": ""
    },
    {
      "id": "releaseMessage",
      "type": "promptString",
      "description": "Release message (use \\n for each new line)",
      "default": ""
    }
  ]
}
